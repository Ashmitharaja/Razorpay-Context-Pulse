# Copy this file to .env and fill in your OWN credentials.
# Nothing in this project works end-to-end without real keys here —
# that is intentional: Track 3 is about real revenue recovery integrations.

# --- Razorpay Test Mode keys ---
# https://dashboard.razorpay.com/app/keys  (Test Mode toggle, top right)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard > Account & Settings > Webhooks > Create Webhook
# Point it at: https://<your-ngrok-or-deployed-url>/webhook/razorpay
# Subscribe to the "payment.failed" event. Copy the secret you set here.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --- LLM agent (pick ONE provider) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini
# --- LLM agent (Free Tier using Google Gemini) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gemini-3.6-flash

# --- Twilio (WhatsApp Sandbox is free) ---
# https://www.twilio.com/try-twilio -> Console -> Messaging -> Try WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_SMS_FROM=+15017122661

# --- App ---
BASE_URL=http://localhost:8000
DATABASE_PATH=contextpulse.db

